# ── Variables PÚBLICAS del frontend (se incrustan en el bundle; nunca pongas secretos aquí) ──
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx (Project Settings → API Keys)
VITE_CLOUDINARY_CLOUD_NAME=tu-cloud-name
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Solo dígitos con código de país, sin "+" (ej. Colombia 57)
VITE_WHATSAPP_NUMBER=573001234567
VITE_INSTAGRAM_URL=https://instagram.com/tu-usuario
VITE_SITE_URL=http://localhost:5173

# ── SECRETOS DE SERVIDOR: NO van en .env.local del frontend ──
# Se configuran con `npx supabase secrets set` (Edge Functions) y en GitHub Actions secrets.
# Para las pruebas de seguridad se copian a .env.test.local (ignorado por git).
# SUPABASE_SERVICE_ROLE_KEY=ejemplo-no-real
# CLOUDINARY_API_KEY=000000000000000
# CLOUDINARY_API_SECRET=ejemplo-no-real
# ADMIN_EMAIL=correo-del-propietario@example.com
# CRON_SECRET=cadena-aleatoria-larga
# ALLOWED_ORIGINS=http://localhost:5173,https://tu-sitio.workers.dev
